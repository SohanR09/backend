# Copy to ".env" (same folder as docker-compose.yml) and set your own values.
#   PowerShell:  Copy-Item .env.example .env

# --- PostgreSQL (runs in a Docker container, data stored in the "pgdata" volume) ---
DB_USER=geofence
# REQUIRED: choose a strong password. Never commit .env.
DB_PASSWORD=8114
DB_NAME=geofence
# NOTE: Postgres reads these only on the FIRST start, when the volume is empty.
# Changing DB_PASSWORD later does not change the stored password; run `docker compose down -v` to start fresh.
# Optional: host port used to reach the database from your machine (DBeaver, psql, ...)
# DB_HOST_PORT=5432

# --- API ---
PORT=8080
# Set a value to require "X-API-Key: <value>" on every request (except /health). Empty = no auth.
API_KEY=
RATE_LIMIT_PER_SEC=50
RATE_LIMIT_BURST=100
